# ============================================
# 智能旅行规划系统 · 后端环境变量模板
# 使用方法：复制本文件为 backend/.env 并填写真实值
# 注意：真实 .env 已存在于项目（学习阶段遗留），
#       本项目需要补充的键：AMAP_WEB_KEY / AMAP_JS_KEY
# ============================================

# ---------- LLM：deepseek（OpenAI 兼容 + 原生多模态） ----------
DEEPSEEK_API_KEY=sk-你的deepseek密钥
DEEPSEEK_MODEL_ID=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60

# ---------- 高德地图（必须注册 https://lbs.amap.com/ 个人开发者） ----------
AMAP_WEB_KEY=你的Web服务Key（后端：天气/地理编码/POI/路线）
AMAP_JS_KEY=你的Web端JS Key（前端：地图渲染）

# ---------- Redis 缓存 ----------
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_DEFAULT=21600

# ---------- 嵌入模型（RAG 向量化；复用旧项目 EMBED 配置） ----------
EMBED_MODEL_TYPE=dashscope
EMBED_API_KEY=你的dashscope密钥
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL_NAME=text-embedding-v3

# ---------- 重排序模型（可选，空则跳过精排） ----------
RERANK_MODEL=
