{
  "description": "RAG 查询扩展规则：把用户口语化查询映射到攻略中的关键词，提升召回效果。Query Rewrite 的规则级 fallback 使用本配置。",
  "rules": [
    {
      "raw": "亲子",
      "expanded": ["亲子", "带孩子", "儿童", "家庭", "小孩"]
    },
    {
      "raw": "美食",
      "expanded": ["美食", "小吃", "餐厅", "特色菜", "餐饮", "必吃"]
    },
    {
      "raw": "人文",
      "expanded": ["人文", "历史", "博物馆", "古迹", "文化"]
    },
    {
      "raw": "自然",
      "expanded": ["自然", "风景", "公园", "山水", "户外"]
    },
    {
      "raw": "夜景",
      "expanded": ["夜景", "夜游", "灯光", "夜市"]
    },
    {
      "raw": "交通",
      "expanded": ["交通", "地铁", "公交", "打车", "机场", "高铁"]
    },
    {
      "raw": "门票",
      "expanded": ["门票", "票价", "免费", "预约"]
    },
    {
      "raw": "省钱",
      "expanded": ["省钱", "预算", "便宜", "经济"]
    },
    {
      "raw": "小众",
      "expanded": ["小众", "冷门", "人少", "秘境"]
    },
    {
      "raw": "打卡",
      "expanded": ["打卡", "网红", "拍照", "必去", "经典"]
    }
  ]
}
